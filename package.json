{
  "name": "stuck",
  "displayName": "Stuck — AI Agent Observability",
  "description": "Traces AI coding agent activity (file edits, terminal commands, git commits, agent tool calls) as OpenTelemetry spans, sends them to a local SigNoz instance, and generates postmortem reports when sessions end.",
  "version": "0.1.0",
  "publisher": "ksploitx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksploitx/stuck.git"
  },
  "keywords": [
    "ai",
    "agent",
    "observability",
    "opentelemetry",
    "signoz",
    "tracing",
    "postmortem",
    "antigravity"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Stuck",
      "properties": {
        "stuck.otlpEndpoint": {
          "type": "string",
          "default": "http://localhost:4318",
          "description": "The OTLP HTTP endpoint URL to send telemetry data to."
        },
        "stuck.cdpPort": {
          "type": "number",
          "default": 9000,
          "description": "CDP remote debugging port for Antigravity agent panel."
        },
        "stuck.cdpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CDP bridge for Antigravity-specific agent instrumentation. Disable on Cursor or plain VS Code."
        },
        "stuck.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "description": "Minutes of inactivity after the last captured span before triggering a postmortem report."
        },
        "stuck.signozQueryEndpoint": {
          "type": "string",
          "default": "http://localhost:3301",
          "description": "SigNoz query-service API endpoint for retrieving trace data."
        },
        "stuck.llmProvider": {
          "type": "string",
          "enum": ["anthropic", "openai", "ollama"],
          "default": "ollama",
          "description": "LLM provider for postmortem report generation. Auto-detected from API key settings if not explicitly set."
        },
        "stuck.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for postmortem report generation."
        },
        "stuck.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for postmortem report generation."
        },
        "stuck.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API endpoint for local LLM postmortem report generation."
        },
        "stuck.ollamaModel": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model name for postmortem report generation."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stuck-sidebar",
          "title": "Stuck",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "stuck-sidebar": [
        {
          "type": "webview",
          "id": "stuck-sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "stuck.openPostmortem",
        "title": "Stuck: Open Postmortem Report"
      },
      {
        "command": "stuck.refreshSessions",
        "title": "Stuck: Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stuck.refreshSessions",
          "when": "view == stuck-sessions",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "chrome-remote-interface": "^0.34.0"
  }
}
